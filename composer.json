{
    "name": "bug-collector/laravel-client",
    "description": "Client Laravel pour Bug Collector : reporte les erreurs et les anomalies de performance (requêtes, jobs, queries, commandes lentes) à un service Bug Collector centralisé.",
    "type": "library",
    "license": "MIT",
    "keywords": ["laravel", "error-reporting", "performance", "monitoring", "bug-collector"],
    "homepage": "https://github.com/hugo-bachmann/laravel-bug-collector-client",
    "authors": [
        {
            "name": "Hugo Bachmann",
            "email": "hugo.bachmann68@gmail.com"
        }
    ],
    "support": {
        "issues": "https://github.com/hugo-bachmann/laravel-bug-collector-client/issues",
        "source": "https://github.com/hugo-bachmann/laravel-bug-collector-client"
    },
    "require": {
        "php": "^8.2",
        "illuminate/support": "^11.0|^12.0|^13.0",
        "illuminate/http": "^11.0|^12.0|^13.0"
    },
    "require-dev": {
        "larastan/larastan": "^3.0",
        "laravel/pint": "^1.0",
        "mockery/mockery": "^1.6",
        "orchestra/testbench": "^9.0|^10.0|^11.0",
        "phpunit/phpunit": "^11.0|^12.0"
    },
    "autoload": {
        "psr-4": {
            "BugCollector\\Client\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "BugCollector\\Client\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "BugCollector\\Client\\BugCollectorServiceProvider"
            ]
        }
    },
    "scripts": {
        "test": "phpunit",
        "lint": "pint --test",
        "format": "pint",
        "analyse": "phpstan analyse"
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
